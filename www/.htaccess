DirectoryIndex index.cgi

RewriteEngine On
# /1234/... 形式をディスパッチャに渡す（実在ファイル・ディレクトリは除外）
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(\d{4})(/.*)?$ index.cgi/$1$2 [L,QSA]

# 言語切替（/set-lang）もディスパッチャに渡す
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^set-lang$ index.cgi/set-lang [L,QSA]
